{
  "name": "salla-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Salla Community QA automation portfolio with Playwright, TypeScript and Allure",
  "scripts": {
    "test": "node scripts/run-suite.cjs --suite all --platform Web",
    "test:all": "node scripts/run-suite.cjs --suite all --platform Web",
    "test:regression": "node scripts/run-suite.cjs --suite regression --platform Both",
    "test:smoke": "node scripts/run-suite.cjs --suite smoke --platform Both",
    "test:headed": "node scripts/run-suite.cjs --suite all --platform Web --headed",
    "test:ui": "playwright test --ui",
    "check": "tsc --noEmit",
    "setup:verify": "node scripts/verify-setup.cjs",
    "report": "node scripts/open-report.cjs playwright",
    "test:web": "node scripts/run-suite.cjs --suite all --platform Web",
    "test:community": "node scripts/run-suite.cjs --suite feature-community --platform Web",
    "test:mobile": "node scripts/run-suite.cjs --suite all --platform Mobile",
    "report:share": "node scripts/package-report.cjs",
    "test:debug": "node scripts/run-suite.cjs --suite all --platform Web --debug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "report:allure": "node scripts/open-report.cjs allure",
    "report:generate": "node scripts/package-report.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
